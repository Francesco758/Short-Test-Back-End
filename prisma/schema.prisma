generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int           @id @default(autoincrement())
  email                  String?
  password               String?
  role                   Role
  name                   String?
  isGuest                Boolean       @default(false)
  companyId              Int?
  createdByAdmin         Boolean       @default(false)
  createdById            Int?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  lastLoginAt            DateTime?
  deletedAt              DateTime?
  function               String?
  seniorityBand          String?
  dateOfBirth            DateTime?
  companyTestAssignments CompanyTest[]
  tests                  Test[]        @relation("UserTests")
  company                Company?      @relation(fields: [companyId], references: [id])
  createdBy              User?         @relation("UserCreatesUsers", fields: [createdById], references: [id])
  createdUsers           User[]        @relation("UserCreatesUsers")
  assignedTests          UserTest[]

  aiUsageRecords   AiUsage[]
  aiConversations  AiConversation[]
  teamProblems     TeamProblem[]
  teamSolutions    TeamSolution[]
  solutionLikes    SolutionLike[]

  @@index([companyId])
  @@index([email])
  @@index([role])
  @@index([companyId, deletedAt])
  @@index([isGuest])
  @@index([name, companyId, isGuest])
}

model Company {
  id               Int           @id @default(autoincrement())
  name             String        @unique
  description      String?
  organizationType OrganizationType @default(COMPANY)
  organizationSize String?
  country          String?
  isActive         Boolean       @default(true)
  guestMode        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  assignedTests    CompanyTest[]
  tests            Test[]        @relation("CompanyTests")
  users            User[]
  userTests        UserTest[]
  aiUsageRecords   AiUsage[]
  teamProblems     TeamProblem[]
  teamSolutions    TeamSolution[]
  reportEmbeddings   ReportEmbedding[]
  aiConversations    AiConversation[]
}

model Test {
  id                 Int           @id @default(autoincrement())
  title              String
  description        String?
  systemPrompt       String        @db.Text
  settings           Json?
  status             TestStatus    @default(DRAFT)
  isCustom           Boolean       @default(false)
  createdById        Int
  companyId          Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?
  companyAssignments CompanyTest[]
  company            Company?      @relation("CompanyTests", fields: [companyId], references: [id])
  createdBy          User          @relation("UserTests", fields: [createdById], references: [id])
  testAttempts       TestAttempt[] @relation("TestAttempts")
  userAssignments    UserTest[]

  @@index([createdById])
  @@index([companyId])
  @@index([status])
}

model CompanyTest {
  id           Int      @id @default(autoincrement())
  companyId    Int
  testId       Int
  assignedAt   DateTime @default(now())
  assignedById Int
  guestAccess  Boolean  @default(false)
  assignedBy   User     @relation(fields: [assignedById], references: [id])
  company      Company  @relation(fields: [companyId], references: [id])
  test         Test     @relation(fields: [testId], references: [id])

  @@unique([companyId, testId])
  @@index([companyId])
  @@index([testId])
  @@index([guestAccess])
}

model UserTest {
  id          Int            @id @default(autoincrement())
  userId      Int
  testId      Int
  companyId   Int
  status      UserTestStatus @default(ASSIGNED)
  assignedAt  DateTime       @default(now())
  deadline    DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  brief       String?        @db.Text
  // Who created this assignment: 'manager' (assigned from the manager/admin
  // dashboard) or 'self' (started by the user from the dashboard). Null = legacy
  // row created before this field existed (treated as manager-assigned).
  source      String?
  totalTime   Int?
  report      Report?
  attempts    TestAttempt[]
  company     Company        @relation(fields: [companyId], references: [id])
  test        Test           @relation(fields: [testId], references: [id])
  user        User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([testId])
  @@index([companyId])
  @@index([status])
  @@index([userId, status])
  @@index([companyId, assignedAt])
  @@index([companyId, status])
  @@index([companyId, status, deadline])
}

model TestAttempt {
  id           Int          @id @default(autoincrement())
  userTestId   Int
  testId       Int?
  messageCount Int          @default(0)
  kpis         Json?
  metadata     Json?
  isCompleted  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  gptMessages  GPTMessage[]
  answers      TestAnswer[]
  test         Test?        @relation("TestAttempts", fields: [testId], references: [id])
  userTest     UserTest     @relation(fields: [userTestId], references: [id])

  @@index([userTestId])
  @@index([testId])
}

model TestAnswer {
  id            Int         @id @default(autoincrement())
  testAttemptId Int
  messageIndex  Int
  userMessage   String      @db.Text
  gptResponse   String?     @db.Text
  gptRating     Int?
  gptFeedback   String?     @db.Text
  components    Json?
  createdAt     DateTime    @default(now())
  testAttempt   TestAttempt @relation(fields: [testAttemptId], references: [id])

  @@index([testAttemptId])
  @@index([messageIndex])
}

model Report {
  id               Int      @id @default(autoincrement())
  userTestId       Int      @unique
  summary          String   @db.Text
  kpis             Json
  detailedAnalysis Json?
  createdAt        DateTime @default(now())
  userTest         UserTest @relation(fields: [userTestId], references: [id])

  @@index([userTestId])
  @@index([createdAt])
}

model GPTMessage {
  id            Int         @id @default(autoincrement())
  testAttemptId Int
  role          String
  content       String      @db.Text
  createdAt     DateTime    @default(now())
  testAttempt   TestAttempt @relation(fields: [testAttemptId], references: [id])

  @@index([testAttemptId])
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiUsage {
  id               Int      @id @default(autoincrement())
  userId           Int?
  companyId        Int?
  source           String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCostUsd Float
  metadata         Json?
  createdAt        DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([source])
  @@index([createdAt])
}

model AiConversation {
  id            Int                   @id @default(autoincrement())
  userId        Int?
  companyId     Int?
  scope         String                @default("company") // "company" | "admin"
  title         String                @default("AI Conversation")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?

  user          User?                 @relation(fields: [userId], references: [id])
  company       Company?              @relation(fields: [companyId], references: [id])
  messages      AiConversationMessage[]

  @@index([userId])
  @@index([companyId])
  @@index([scope])
  @@index([companyId, scope, updatedAt])
}

model AiConversationMessage {
  id             Int            @id @default(autoincrement())
  conversationId Int
  role           String         // "user" | "assistant"
  content        String         @db.Text
  source         String?
  chartSpec      Json?
  imageUrl       String?
  imageSize      String?
  metadata       Json?
  createdAt      DateTime       @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([conversationId, createdAt])
}
model TeamProblem {
  id            Int           @id @default(autoincrement())
  companyId     Int
  key           String
  topic         String
  description   String        @db.Text
  frequency     Int           @default(0)
  source        String        @default("evaluation")
  createdById   Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  clusterId     String?
  clusterLabel  String?

  company       Company       @relation(fields: [companyId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])
  solutions     TeamSolution[]

  @@unique([companyId, key])
  @@index([companyId])
  @@index([frequency])
  @@index([clusterId])
}

model TeamSolution {
  id            Int           @id @default(autoincrement())
  companyId     Int
  problemId     Int?
  key           String
  topic         String
  description   String        @db.Text
  source        String        @default("evaluation")
  createdById   Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  clusterId     String?
  clusterLabel  String?

  company       Company       @relation(fields: [companyId], references: [id])
  problem       TeamProblem?  @relation(fields: [problemId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])
  likes         SolutionLike[]

  @@unique([companyId, key])
  @@index([companyId])
  @@index([createdAt])
  @@index([clusterId])
}

model ReportEmbedding {
  id         Int      @id @default(autoincrement())
  companyId  Int?
  reportId   Int
  type       String
  key        String
  topic      String
  summary    String   @db.Text
  embedding  String   @db.Text
  createdAt  DateTime @default(now())

  company    Company? @relation(fields: [companyId], references: [id])

  @@unique([reportId, type])
  @@index([companyId])
  @@index([companyId, type])
}

model SolutionLike {
  id            Int           @id @default(autoincrement())
  solutionId    Int
  userId        Int
  createdAt     DateTime      @default(now())

  solution      TeamSolution  @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])

  @@unique([solutionId, userId])
  @@index([solutionId])
}

enum OrganizationType {
  COMPANY
  TEAM
  UNIVERSITY
  CLASSROOM
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  USER
  STUDENT
  TEACHER
  GUEST
}

enum TestStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserTestStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}
